# Local compose settings. Never commit the populated .env file.
POSTGRES_DB=devs
POSTGRES_USER=devs
POSTGRES_PASSWORD=change-me-locally
VITE_API_URL=http://localhost:8080/devs/api/v1

# Set false when testing the real central JWT integration locally.
DEVS_JWT_ENABLED=false
DEVS_ALLOW_INSECURE_ADMIN=true
DEVS_JWT_PUBLIC_KEY=
DEVS_JWT_ISSUER=
DEVS_ADMIN_SUBJECTS=

# Production provider values (optional for public/catalog development).
STATIC_HLS_ENABLED=false
STATIC_HLS_BASE_URL=https://video.example.com/
STATIC_HLS_ALLOWED_PATH_PREFIX=lessons
STATIC_HLS_VALIDATION_TIMEOUT=10s
DEVS_MEDIA_RETENTION=P7D
DEVS_MEDIA_VERSION_RETENTION=P30D
DEVS_MEDIA_PURGE_DELAY=PT1H
DEVS_MEDIA_STALE_UPLOAD_AFTER=PT24H
DEVS_TRASH_PURGE_DELAY=PT1H
R2_ENABLED=false
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENTS_PUBLIC_BASE_URL=https://video.example.com/
ATTACHMENTS_MAX_UPLOAD_BYTES=104857600
ATTACHMENTS_MAX_PER_UNIT=20
ATTACHMENTS_RETENTION=P7D
ATTACHMENTS_PURGE_DELAY=PT1H
ATTACHMENTS_STALE_UPLOAD_AFTER=PT24H
